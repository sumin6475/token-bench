{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenBench",
  "version": "0.2.0",
  "identifier": "dev.sumin.tokenbench",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "TokenBench",
        "url": "http://localhost:4318/widget",
        "width": 344,
        "height": 470,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "externalBin": ["binaries/node"],
    "resources": {
      "../../collector.js": "sidecar/collector.js",
      "../../widget.html": "sidecar/widget.html",
      "../../dashboard.html": "sidecar/dashboard.html",
      "../../pricing.json": "sidecar/pricing.json",
      "../../context-windows.json": "sidecar/context-windows.json",
      "../../src/store.js": "sidecar/src/store.js",
      "../../src/pricing.js": "sidecar/src/pricing.js",
      "../../src/proxy-core.js": "sidecar/src/proxy-core.js",
      "../../src/cli-session-scanner.js": "sidecar/src/cli-session-scanner.js",
      "../../src/schema.sql": "sidecar/src/schema.sql",
      "../../bin/tokenbench": "sidecar/bin/tokenbench",
      "../../tb-claude": "sidecar/tb-claude",
      "../../stats.js": "sidecar/stats.js",
      "../../env.sh": "sidecar/env.sh"
    }
  }
}
